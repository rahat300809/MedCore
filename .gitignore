# MedCore .gitignore

# Sensitive local overrides (if using a distinct local config file)
# app/config/database.local.php

# Uploaded files (not tracked in git)
storage/uploads/
storage/logs/
uploads/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# PHP temp
*.php~
*.bak

# Composer (if used later)
vendor/
composer.lock

# Node (if used)
node_modules/
npm-debug.log

# PHPUnit
.phpunit.result.cache

# Environment
.env
.env.local

# Scratch & test scripts
scratch/

# Root assets junction (mirrored from public/assets)
assets/

# Keep storage directories structure
!storage/uploads/.gitkeep
!storage/logs/.gitkeep
